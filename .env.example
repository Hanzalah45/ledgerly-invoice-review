APP_NAME=Ledgerly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=corehives_doc_ai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" processes uploads immediately (best for demos). Use "database" plus
# `php artisan queue:work` for production-style background processing.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@ledgerly.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---- Ledgerly document extraction ----
# demo      = rule-based parser that reads the PDF text locally. NOT an AI model.
# openai    = live extraction through the OpenAI Chat Completions API
# anthropic = live extraction through the Anthropic Messages API
DOCAI_PROVIDER=demo
DOCAI_OPENAI_API_KEY=
DOCAI_OPENAI_MODEL=gpt-4o-mini
DOCAI_ANTHROPIC_API_KEY=
DOCAI_ANTHROPIC_MODEL=claude-sonnet-5-5
DOCAI_MAX_UPLOAD_KB=10240
DOCAI_TIMEOUT_SECONDS=60
